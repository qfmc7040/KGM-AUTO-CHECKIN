# kgcheckin 私密配置模板
# 复制本文件为 .env（已被 .gitignore 忽略，不会提交），填入自己的值即可生效。
# 通知渠道全部可选，配置多个将同时发送。

# ── 容器运行身份（PUID / PGID）──
# 容器以 root 启动，入口脚本会先把挂载卷 ./data 的属主改成这里指定的 uid:gid，
# 再降权到该身份运行业务进程（WebUI / 签到都跑在普通用户下，不跑在 root）。
# 目的：解决「data 目录被 sudo 或 Docker 守护进程以 root 创建」导致写不进 userinfo.json 的问题。
# 留空（推荐）= 自动沿用宿主机 ./data 目录现有属主；目录不存在或属主是 root 时回落到 1000:1000。
# 需要指定时填宿主机当前用户的 uid / gid：Linux 执行 id -u 与 id -g；NAS（群晖/威联通）填对应用户的 uid。
# PUID=1000
# PGID=1000

# ── WebUI 访问密码（公网暴露时强烈建议设置）──
# WEBUI_PASSWORD=change-me

# ── 账号管理模块密码 ──
# 账号管理采用「每账号独立密码」：未自行修改过密码的账号，其登录密码即酷狗ID
# （便于用户首次登录后自助修改；可用 ACCOUNTS_DISABLE_ID_DEFAULT 关闭，见下）。
# 此处设置的是管理员账号 admin 的密码；不设置则 admin 不可用。
# 首次部署也可用 ACCOUNTS_BOOTSTRAP_PASSWORD 初始化 admin 密码（写入 accounts_auth.json）。
# ACCOUNTS_PASSWORD=change-me-too
# ACCOUNTS_BOOTSTRAP_PASSWORD=
# 防爆破：单账号 / 单 IP 双维度锁定
# ACCOUNTS_MAX_ATTEMPTS=3
# ACCOUNTS_IP_MAX_ATTEMPTS=15
# ACCOUNTS_LOCK_MINUTES=5
# 账号默认密码：未自行修改过密码的账号，登录密码即其酷狗ID（便于用户首次登录后自助改密）。
#
# ⚠ 安全权衡：酷狗ID 并非秘密（账号列表接口会返回，用户之间也会互相告知），
#   因此任何知道该 ID 的人都能登录该账号并改掉密码，把号主锁在外面。
#   若面板对公网暴露，请至少做到以下之一：
#     1) 设置 WEBUI_PASSWORD（全局访问密码），或
#     2) 由 admin 预先为各账号设置密码（设置后默认密码即失效），或
#     3) 设为 true 关闭默认密码，此时未设密码的账号须由 admin 先设置密码。
# ACCOUNTS_DISABLE_ID_DEFAULT=false

# ── 反向代理 ──
# 部署在 Nginx/Caddy/Cloudflare Tunnel 等反向代理之后时设置，以获取真实客户端 IP。
# 未设置时不信任 X-Forwarded-For，避免伪造 IP 绕过防爆破计数。
# ⚠ 公网部署务必设置：否则所有外部请求都会被当成同一个代理内网地址，
#   账号防爆破的 IP 桶会互相拖累、二维码限流会被整体豁免（启动横幅会红字提醒）。
# WEBUI_TRUST_PROXY=1

# ── 公网接口限流 ──
# 保护会向酷狗发起真实请求、且可被匿名调用的接口；格式 "次数/分钟"，留空用默认值，
# 设为 "0/1" 关闭该项。
# 除二维码生成外均按 全局 / 手机号 / 账号 计数，不依赖来源 IP：
# 容器端口映射下 req.ip 恒为网桥地址（如 172.17.0.1），反向代理下又取自可伪造的
# X-Forwarded-For，按 IP 计数在两种部署下都不可靠。
# 发送短信验证码：默认全服务每小时 20 次、每手机号 24 小时 2 次
# （防止本服务被当作短信轰炸机，也避免出口设备标识被酷狗风控判为刷量）。
# WEBUI_PHONE_SEND_GLOBAL_LIMIT=20/60
# WEBUI_PHONE_SEND_PHONE_LIMIT=2/1440
# 生成登录二维码：仍按 IP，默认每 IP 每 3 分钟 1 次（每次都会向酷狗申请新的登录 key），
# 内网 / 本机 IP 自动豁免（依赖上面的 WEBUI_TRUST_PROXY 正确设置）。
# WEBUI_QR_GEN_IP_LIMIT=1/3

# ── 酷狗设备标识（建议设置并固定）──
# 这三项是「存量账号」的设备标识：已存在的账号在升级后会自动补上这三项的值，
# 而新登录的账号（含老账号重新登录）各自使用一套自动生成的标识，互不相同。
# 登录 API 服务每次重启默认随机生成设备 ID，频繁变化会被酷狗风控静默丢弃验证码短信；
# 固定后风控看到的是稳定设备。MID 建议 36-39 位纯数字，DEV 建议 10 位大写字母数字。
# 留空时存量账号沿用程序内置的全局固定值；如需自定义请三项一起填。
# KUGOU_API_GUID=
# KUGOU_API_MID=
# KUGOU_API_DEV=

# ── 签到行为 ──
# 多账号并行路数：≤6 个账号默认全部同时并行；超过 6 个默认限 3 路（降低同 IP 高并发风控风险）。
# 设 N = 限 N 路；1 = 逐个串行；max 或 0 = 不限（全部并行）。
# CHECKIN_CONCURRENCY=
# 设为 true 时跳过「当日已完成签到」的账号，避免重复请求酷狗接口（Docker 与 Actions 通用）。
# CHECKIN_SKIP_DONE=false
# 单账号签到的每日配额：每个 userid 每天最多 N 次（默认 2；设 0 关闭）。
# 按北京时间跨天重置，不分 IP（换 IP 也不能绕过）——这是「立即签到」接口唯一的限流维度。
# 每次手动签到都会拉起 API 子进程并请求酷狗接口，公网暴露时建议保留。
# CHECKIN_PER_USERID_DAILY=2
# 定时签到计划（cron 表达式）与时区；默认每天北京时间 01:10。
# CRON_SCHEDULE=10 1 * * *
# CRON_TIMEZONE=Asia/Shanghai
# true：容器启动后立即执行一次签到。
# RUN_ON_STARTUP=false

# ── 邮箱 SMTP 通知 ──
# MAIL_HOST=smtp.qq.com
# MAIL_PORT=465
# MAIL_USER=your_email@qq.com
# MAIL_PASS=SMTP授权码（非登录密码）
# MAIL_TO=your_email@qq.com

# ── 按账号的失效邮件提醒 ──
# 用户在 WebUI 登录成功后自行预留邮箱并完成验证，之后某天该账号的登录凭据失效
# （酷狗返回 error_code 20018）时，系统会用上面的 SMTP 单独给该用户发一封提醒邮件。
# 未绑定邮箱、或邮箱未验证的账号不会收到任何邮件。
# 发件人显示名（From 头里的名称部分），默认「酷狗签到助手」。
# MAIL_FROM_NAME=酷狗签到助手
# 失效邮件开关：留空 = 开启；设为 false / 0 关闭。
# MAIL_INVALID_NOTIFY=
# 同一账号的失效提醒冷却天数，默认 7（即每 7 天最多提醒一次）。
# MAIL_NOTICE_COOLDOWN_DAYS=7
# 邮箱验证码发送限流（"次数/分钟"，按目标账号计数，不依赖来源 IP；设为 0/1 关闭）。
# WEBUI_EMAIL_SEND_USER_LIMIT=3/60
# WebUI 的公网地址，会附加在失效邮件正文里，方便用户点开重新登录（可选）。
# WEBUI_PUBLIC_URL=

# ── 企业微信机器人 ──
# WECOM_BOT_KEY=

# ── 钉钉机器人（加签可选）──
# DINGTALK_BOT_KEY=
# DINGTALK_SECRET=

# ── 飞书机器人 ──
# FEISHU_BOT_KEY=

# ── 云湖机器人 ──
# YUNHU_BOT_KEY=

# ── Server酱 ──
# SERVERCHAN_SENDKEY=

# ── PushPlus ──
# PUSHPLUS_TOKEN=
# PUSHPLUS_TOPIC=

# ── Telegram ──
# TG_BOT_TOKEN=
# TG_CHAT_ID=

# ── Bark (iOS) ──
# BARK_KEY=
# BARK_GROUP=

# ── Discord Webhook ──
# DISCORD_WEBHOOK=
